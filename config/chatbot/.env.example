# Copy to .env; this file is parsed as data, never executed as shell code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
# Local throttle only; check the project's actual quota in AI Studio.
CHATBOT_MIN_INTERVAL_SECONDS=6
CHATBOT_TIMEOUT_SECONDS=15
CHATBOT_TOTAL_TIMEOUT_SECONDS=35
